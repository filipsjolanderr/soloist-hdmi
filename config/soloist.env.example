# Copy to ~/.config/soloist-hdmi/env and chmod 600.
# This file holds a secret - it is gitignored and must never be committed.

# Spotify Soloist developer API key (from the Spotify for Developers dashboard).
SOLOIST_API_KEY=paste-your-key-here

# Name shown in the Spotify Connect device picker.
SOLOIST_DEVICE_NAME=Hi-Fi System

# PipeWire node to route audio to. Find it with: scripts/find-hdmi-node.sh
SOLOIST_PIPEWIRE_NODE=alsa_output.platform-3f902000.hdmi.hdmi-stereo

# 100 = no digital attenuation; let the receiver's own volume control do the
# attenuating. Turn the receiver DOWN before first playback.
SOLOIST_INITIAL_VOLUME=100

# Cache cap in MB (min 100). Keeps the SD card from filling up.
SOLOIST_CACHE_SIZE_MB=500

# --- HDMI-CEC -------------------------------------------------------------
# Wake the receiver and select this input when a Connect session starts or
# playback begins. Set to 0 to leave the receiver alone.
SOLOIST_CEC_WAKE=1

# Put the receiver into standby after this many minutes with nothing playing.
# 0 disables it. Paused counts as idle; the countdown restarts on play.
SOLOIST_CEC_IDLE_MINUTES=30
SOLOIST_CEC_STANDBY=1

# Logical address of the device to send standby to. 5 is the Audio System,
# i.e. the amplifier alone - deliberately not a broadcast, which would take
# the TV down with it.
SOLOIST_CEC_AMP=5

# OSD name this box announces on the CEC bus. The spec caps it at 14
# characters; matching the Connect name keeps the amplifier's input list and
# Spotify's device picker in agreement.
SOLOIST_CEC_OSD_NAME=Hi-Fi System
