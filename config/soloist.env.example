# Copy to ~/.config/soloist-hdmi/env and chmod 600.
# This file holds a secret - it is gitignored and must never be committed.

# Spotify Soloist developer API key (from the Spotify for Developers dashboard).
SOLOIST_API_KEY=paste-your-key-here

# Name shown in the Spotify Connect device picker.
SOLOIST_DEVICE_NAME=Hi-Fi System

# PipeWire node to route audio to. This is the mono sink published by
# pipewire/20-mono-right.conf, NOT the hardware sink - it downmixes to one
# channel and puts it on the right side of the jack. Set it to the hardware
# sink instead if you go back to two speakers; find it with:
#   scripts/find-audio-node.sh
SOLOIST_PIPEWIRE_NODE=soloist_mono_right

# 100 = no digital attenuation; let the amplifier's own volume control do the
# attenuating. Unlike the HDMI box this does NOT mean the sink runs at the top
# of the hardware mixer - see wireplumber/50-aux-softmixer.conf, which keeps the
# bcm2835 control pinned at 0 dB so 100 really is unity rather than +4 dB.
# Turn the amplifier DOWN before first playback.
SOLOIST_INITIAL_VOLUME=100

# Cache cap in MB (min 100). Keeps the SD card from filling up.
SOLOIST_CACHE_SIZE_MB=500
