# Copy to ~/.config/soloist-hdmi/env on the CLIENT box (the Zero) and chmod 600.
#
# No API key here: Soloist runs on the server, not on this box. These are only
# the HDMI-CEC knobs for driving the Sony receiver.

# Wake the receiver and select this input when playback starts. 0 leaves the
# receiver alone entirely.
SOLOIST_CEC_WAKE=1

# Put the receiver into standby after this many minutes without playback.
# PAUSED COUNTS: a session left paused is exactly the case worth powering down
# for, since the amplifier is otherwise on, on the right input, amplifying
# silence all night. Resuming cancels the countdown. 0 disables it.
SOLOIST_CEC_IDLE_MINUTES=10
SOLOIST_CEC_STANDBY=1

# Logical address of the device to send standby to. 5 is the Audio System,
# i.e. the amplifier alone - deliberately not a broadcast, which would take
# the TV down with it. Standby is also skipped when another device holds the
# active source, so this cannot power off the amp out from under the Shield.
SOLOIST_CEC_AMP=5

# OSD name this box announces on the CEC bus. The spec caps it at 14 chars.
SOLOIST_CEC_OSD_NAME=Hi-Fi System
