[Unit]
Description=Drive the receiver over HDMI-CEC from playback state
After=soloist.service
Wants=soloist.service
# The script reconnects on its own, so a soloist restart is not fatal.
StartLimitIntervalSec=0

[Service]
Type=simple
# Without this python buffers stdout when it is not a tty and the journal
# stays empty, which makes the service look silently broken.
Environment=PYTHONUNBUFFERED=1
EnvironmentFile=%h/.config/soloist-hdmi/env
ExecStart=/usr/bin/python3 %h/soloist-hdmi/cec/soloist-cec.py

Restart=always
RestartSec=5

# /dev/cec0 is root:video and the user is in the video group, so cec-ctl needs
# no privilege. Re-arming after a receiver power cycle does: it calls
# scripts/cec-rearm.sh through sudo, which cannot work under NoNewPrivileges=.
NoNewPrivileges=false

[Install]
WantedBy=default.target
