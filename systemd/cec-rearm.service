[Unit]
Description=Give the HDMI-CEC adapter its physical address back
Documentation=https://github.com/filipsjolander/soloist-hdmi
# Unlike every other unit here this is a *system* unit, not a user one: it
# writes /sys/class/drm/*/status and the DRM debugfs force knob, and it is
# started by udev, which can only reach system units.
ConditionPathExists=/dev/cec0

[Service]
Type=oneshot
# __REPO__ is substituted by install.sh - a system unit has no %h to expand.
ExecStart=__REPO__/scripts/cec-rearm.sh
# 75 (EX_TEMPFAIL) means the receiver was off, so there was no EDID to take an
# address from. That is an ordinary state for a hi-fi, not a failure worth
# showing up in `systemctl --failed`; the next hotplug re-runs this anyway.
SuccessExitStatus=75

[Install]
WantedBy=multi-user.target
