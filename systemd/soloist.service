[Unit]
Description=Spotify Soloist (Spotify Connect -> analog jack, mono right)
Documentation=https://developer.spotify.com/documentation/soloist
# PipeWire provides the mono sink; start after it is up.
After=pipewire.service wireplumber.service pipewire-pulse.service
Wants=pipewire.service wireplumber.service
# soloist opens its PipeWire stream once and does not reconnect: restart
# PipeWire underneath it and it keeps running, keeps reporting "playing", and
# silently feeds nothing into the FIFO. PartOf makes systemd restart it with
# PipeWire so that cannot happen. snapclient deliberately does not need this -
# it notices and reconnects on its own.
PartOf=pipewire.service
# Never give up: on boot the service may start before Wi-Fi has associated,
# and Restart=always must not trip systemd's start-rate limiter.
StartLimitIntervalSec=0

[Service]
Type=simple
# SOLOIST_API_KEY and SOLOIST_DEVICE_NAME live here, outside the repo, mode 0600.
# Deliberately NOT ~/.config/soloist: systemd symlinks a user unit's
# StateDirectory onto that path, which would drop the secret into the same
# directory soloist writes its state and crash dumps into.
EnvironmentFile=%h/.config/soloist-hdmi/env

# soloist prefers $STATE_DIRECTORY / $CACHE_DIRECTORY when systemd sets them.
# StateDirectory keeps the device identity + Connect session stable across restarts.
StateDirectory=soloist
CacheDirectory=soloist

ExecStart=/usr/local/bin/soloist \
    --device-name "${SOLOIST_DEVICE_NAME}" \
    --api-key "${SOLOIST_API_KEY}" \
    --pipewire-device "${SOLOIST_PIPEWIRE_NODE}" \
    --initial-volume "${SOLOIST_INITIAL_VOLUME}" \
    --cache-size "${SOLOIST_CACHE_SIZE_MB}" \
    --ws 127.0.0.1:3678

Restart=always
RestartSec=5

# Builds expire 90 days after their build date and exit with code 10.
# Restarting an expired binary is pointless - stop and let the updater fix it.
RestartPreventExitStatus=10

# Modest hardening. soloist needs the network, the PipeWire socket in
# XDG_RUNTIME_DIR, and its own state/cache dirs - nothing else.
# (No ProtectHome= : for a user unit StateDirectory lands under ~/.local/state.)
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectControlGroups=true
ProtectKernelTunables=true
ProtectKernelModules=true
RestrictNamespaces=true
RestrictSUIDSGID=true
LockPersonality=true

[Install]
WantedBy=default.target
