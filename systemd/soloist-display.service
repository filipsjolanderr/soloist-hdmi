[Unit]
Description=Now-playing screen on the HDMI output
After=soloist.service
Wants=soloist.service
# The script reconnects on its own, so a soloist restart is not fatal.
StartLimitIntervalSec=0

[Service]
Type=simple
# Without this python buffers stdout when it is not a tty and the journal
# stays empty, which makes the service look silently broken.
Environment=PYTHONUNBUFFERED=1
# Album art cache -> ~/.cache/soloist-display. Deliberately no StateDirectory:
# the script reads soloist's ws.addr/ws.port from ~/.local/state/soloist, and
# declaring StateDirectory here would point $STATE_DIRECTORY somewhere else.
CacheDirectory=soloist-display

# Take the framebuffer from the text console, and give it back on exit.
ExecStartPre=/usr/bin/sudo %h/soloist-hdmi/scripts/fbcon.sh release
ExecStart=/usr/bin/python3 %h/soloist-hdmi/display/soloist-display.py
ExecStopPost=-/usr/bin/sudo %h/soloist-hdmi/scripts/fbcon.sh restore

Restart=always
RestartSec=5

# This unit is deliberately unsandboxed:
#  - /dev/fb0 needs real device access, so PrivateDevices= must stay off
#    (the user is already in the video group).
#  - fbcon.sh writes /sys/class/vtconsole/*/bind, so ProtectKernelTunables=
#    must stay off.
#  - ExecStartPre/ExecStopPost call sudo, which cannot work under
#    NoNewPrivileges=. The other two are already the defaults; this one is
#    stated because it is the constraint that actually binds.
NoNewPrivileges=false

[Install]
WantedBy=default.target
