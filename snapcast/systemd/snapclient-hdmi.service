[Unit]
Description=Snapcast client -> HDMI (Sony receiver)
# A *user* unit: the packaged snapclient.service runs as _snapclient and cannot
# reach filip's PipeWire socket in XDG_RUNTIME_DIR. The system unit is disabled.
After=pipewire.service wireplumber.service pipewire-pulse.service
Wants=pipewire.service wireplumber.service pipewire-pulse.service
StartLimitIntervalSec=0

[Service]
Type=simple
ExecStart=/usr/bin/snapclient \
    --host __SERVER__ \
    --player pulse \
    -s alsa_output.platform-3f902000.hdmi.hdmi-stereo \
    --hostID hifi-hdmi \
    --logsink stdout
Restart=always
RestartSec=5

[Install]
WantedBy=default.target
